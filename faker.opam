# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Generate massive amounts of fake (but realistic) data for testing and development"
description:
  "An OCaml port of @faker-js/faker 10.6.0 with seed-for-seed output parity: for the same seed, every method returns the same value faker-js returns. All 26 modules and all 77 locales are ported."
maintainer: ["Bartek Teodorczyk <barteo@gmail.com>"]
authors: ["Bartek Teodorczyk <barteo@gmail.com>"]
license: "MIT"
tags: ["faker" "fake" "data" "test-data" "mock" "testing"]
homepage: "https://github.com/barteo/faker-ocaml"
bug-reports: "https://github.com/barteo/faker-ocaml/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.0"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/barteo/faker-ocaml.git"
